<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sale Order Form View - Add OdooPilot field after payment_term_id -->
    <record id="view_order_form_odoopilot" model="ir.ui.view">
        <field name="name">sale.order.form.odoopilot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="x_odoopilot" placeholder="Enter OdooPilot value..."/>
            </xpath>
        </field>
    </record>

    <!-- Sale Order List View - Add OdooPilot field -->
    <record id="view_order_tree_odoopilot" model="ir.ui.view">
        <field name="name">sale.order.list.odoopilot</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_quotation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="x_odoopilot" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>